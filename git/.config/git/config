[user]
  name = Shreeram Modi
  # email and signingkey live in ~/.gitconfig.local (per machine, untracked)
  useConfigOnly = true

[credential]
  helper = store

[init]
  defaultBranch = main

[core]
  pager = delta
  abbrev = 12

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true    # use n and N to move between diff sections
  line-numbers = true
  side-by-side = false

    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[tag]
	gpgSign = true

# Per-machine overrides; missing file is silently ignored.
[include]
	path = ~/.gitconfig.local
